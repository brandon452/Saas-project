# ========================
# Django API (Railway)
# ========================
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=replace-with-a-long-random-string

# Supabase — use the "Session Mode" pooler connection (port 5432)
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_SSL_REQUIRE=true

# Upstash — copy the REDIS_URL from the Upstash console
REDIS_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379

# Railway injects PORT automatically — do not set this manually
# PORT=

# Comma-separated list of allowed hostnames for this service
# Include your Railway service domain and any custom API domain
ALLOWED_HOSTS=your-api.up.railway.app,api.yourdomain.com

# The Vercel frontend origin — needed for CORS and CSRF
CORS_ALLOWED_ORIGINS=https://yourapp.vercel.app,https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourapp.vercel.app,https://app.yourdomain.com

# ========================
# Next.js frontend (Vercel)
# ========================
# Internal Railway API URL — server-side only, never exposed to browser
BACKEND_URL=https://your-api.up.railway.app

# Leave NEXT_PUBLIC_API_URL unset in production.
# The proxy rewrites in next.config.mjs handle routing to the API.
# NEXT_PUBLIC_API_URL=
